knowledge/private/
knowledge/notes/*
!knowledge/notes/.gitkeep

# Python
.venv*/
**/.venv*/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/

# Large raw simulation dumps
*.npz

# OS / tools
.DS_Store
.claude/

# Phase 0 replay recordings (large; regenerate with --record)
phase0/replays/*.tsr.gz
phase0/replays/*.b64.txt

# Local outreach drafts (never published)
outreach/

# Downloaded validation data (open licences; fetched by the scripts)
models/py/validation/.cache/
